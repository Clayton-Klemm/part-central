# Local demo database credential. Replace with a strong URL-safe value before starting.
# Use letters, numbers, underscores, and hyphens; this value is part of DATABASE_URL.
POSTGRES_PASSWORD=replace_with_your_own_long_random_password

# Optional local administrator credential for publishing reference versions.
# Leave empty to disable admin writes. Never commit a real credential.
# Use a separate random secret (at least 32 characters), not the database password.
ADMIN_TOKEN=

# Single-server starting point; load test on the actual host before rollout.
# Each worker owns its own pool: 4 * (5 + 5) = at most 40 API DB connections.
API_WORKERS=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# Keep local-only by default. Bind to a server interface only after access,
# HTTPS, operator identity, and network controls are ready.
HOST_BIND=127.0.0.1
WEB_PORT=8080
